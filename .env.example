# Chave que assina os tokens de sessão. Troque por um valor aleatório antes de subir.
NETSPOT_SECRET_KEY=key_secreta

# Senha do usuário admin, criado na primeira subida. O primeiro login exige a troca.
NETSPOT_DEFAULT_ADMIN_PASSWORD=senha_padrao

# Alertas por Telegram. Sem os dois valores, o envio por Telegram fica desligado.
NETSPOT_TELEGRAM_BOT_TOKEN=
NETSPOT_TELEGRAM_CHAT_ID=

# Retenção do histórico de métricas, em dias. O valor 0 desliga a limpeza.
NETSPOT_RETENTION_DAYS=30

# URL do Ollama no host, usada pelo texto do classificador. Opcional.
OLLAMA_URL=http://host.docker.internal:11434

# Banco de dados. O docker-compose sobrescreve para PostgreSQL; fora do Docker o padrão é SQLite.
DATABASE_URL=sqlite:///./noclite.db
